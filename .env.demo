# .env.demo — build ที่ให้ PO / ทีมดูได้โดยไม่ต้องมี backend
#
# ใช้กับ `bun run build:demo` เท่านั้น: axios adapter ใน src/lib/mock/mock-api.ts
# ตอบทุก request (profile / 1 บริษัท 1 สาขา / configuration / ออเดอร์ / ลูกค้า /
# สินค้า / คำแปลไทย) และให้ทุก permission ผ่าน จึงไม่ต้องล็อกอินและไม่ยิงเน็ตออกเลย
# — build นี้จึงเอาไปวางบน static host ที่ไหนก็ได้ ไม่ใช่ของจริง ห้ามใช้กับข้อมูลจริง
NODE_ENV=production
VITE_PROVIDER_CODE=patona,sellsuki,any

# ไม่ต้องแวะ AMS: ไม่มี cookie matching และไม่มี dev header (ไม่มี user id ติดไปใน bundle)
VITE_DISABLE_COOKIE_MATCHING=true
VITE_MOCK_API=true

# URL เหล่านี้ไม่ถูกเรียกจริงในโหมด mock แต่โค้ดอ่านค่าตอน import จึงต้องมีค่า
VITE_AMS_URL=https://accounts.dev-th.patona.online
VITE_ACCOUNT_PATONA_URL=https://accounts.dev-th.patona.online
VITE_CCS_3=https://ccs3.dev-th.patona.online
VITE_MANAGEMENT_URL=https://api.dev-th.patona.online/management
VITE_CUSTOMER_BOOK_URL=https://api.dev-th.patona.online/customer-book/v1
VITE_CUSTOMER_BOOK_V2_URL=https://api.dev-th.patona.online/v2-customer-book/v1
VITE_CENTRAL_CONFIGURATION_SYSTEM_URL=https://api.dev-th.patona.online/central-configuration-system/v1
VITE_I18N_URL=https://api.dev-th.patona.online/i18n-management/v1
VITE_PIS_URL=https://api.dev-th.patona.online/pis
VITE_PIS_IFRAME=https://pis.dev-th.patona.online
VITE_LINE_URL=https://line.me
VITE_IMAGE_BASE_URL=https://api.dev-th.patona.online
VITE_CONFIGURATION_USER_SERVICE_NAME=patona-sellercenter-user
VITE_CONFIGURATION_USER_SELLSUKI_GLOBAL=sellsuki-global-user
VITE_DISABLE_FULLFILLMENT_FEATURE=false

# multi-parcel (หลายพัสดุ): ยังไม่มี backend ส่งอีเมลพัสดุดิจิทัลจริง ปิดไว้เหมือน production
# (ดู src/lib/feature-flags.ts)
VITE_DISABLE_MULTI_PARCEL=true
# รหัสส่วนลด: เปิดใน demo — คูปองมาจาก mock (VITE_MOCK_API) เพื่อให้ทดสอบแท็บคูปอง/สแกนได้
# production ยังปิดอยู่จนกว่าจะมี endpoint คูปองจริง
VITE_DISABLE_DISCOUNT_CODE=
