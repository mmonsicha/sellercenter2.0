VITE_DISABLE_COOKIE_MATCHING=true
# PAT-1851: set to true LOCALLY to preview the slip-review UI with mock data (do NOT commit true). Remove when BE (PAT-1983/2097) ships.
VITE_SLIP_MOCK=false

############################
# LOCAL-ONLY review switches — do NOT commit either as true
############################
# Fully offline shell for UI / design-system review: an axios adapter
# (src/lib/mock/mock-api.ts) answers every request — profile, 1 company + 1 store,
# configuration, orders/customers/products fixtures, Thai i18n keywords — and
# grants EVERY permission, so no page hits a permission wall. No backend needed.
# Needs VITE_DISABLE_COOKIE_MATCHING=true (set below) so login is skipped.
VITE_MOCK_API=true

# Keep REAL backend data but skip the permission gate (src/utils/permission.ts).
# Use when the dev user has no roles on the selected store. Unlocks the gate only —
# a backend that itself refuses can still surface <PermissionDenied />.
# VITE_BYPASS_PERMISSIONS=true
VITE_CONFIGURATION_USER_SERVICE_NAME=patona-seller-center-user
VITE_CONFIGURATION_USER_SELLSUKI_GLOBAL=sellsuki-global-user



VITE_IMAGE_BASE_URL=https://file.dev.sellsuki.com
