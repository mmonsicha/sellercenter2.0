# Copy to .env.dev / .env.development / .env.staging / .env.production and fill in.
# Values (internal API hosts, dev identity headers) are intentionally not committed.

NODE_ENV=development
VITE_ACCOUNT_PATONA_URL=
VITE_ADDITIONS_HEADERS=
VITE_AMS_URL=
VITE_CCS_3=
VITE_CENTRAL_CONFIGURATION_SYSTEM_URL=
VITE_CONFIGURATION_STORE_PATONA_SELLER_CENTER=
VITE_CONFIGURATION_USER_PATONA_SELLER_CENTER=
VITE_CONFIGURATION_USER_SELLSUKI_GLOBAL=
VITE_CONFIGURATION_USER_SERVICE_NAME=
