{
  "name": "sellsuki-system-management-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start:local": "vite --mode dev",
    "start:development": "vite --mode development",
    "start:staging": "vite --mode staging",
    "start:production": "vite --mode production",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "build:development": "vite build --mode development",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "generate-openapi:customer-book": "openapi-typescript http://customer-book-backend.patona.internal.staging.sellsuki.com/swagger/doc.json --output ./src/service/customer-book-gen.ts",
    "generate-openapi:management": "openapi-typescript http://management-backend.patona-dev.internal.staging-th.sellsuki.com/v1/swagger/swagger.json --output ./src/service/management-gen.ts",
    "generate-openapi:paper": "openapi-typescript http://paper-backend.patona.internal.staging.sellsuki.com/swagger/doc.json --output ./src/service/papers-gen.ts",
    "generate-openapi:doms": "openapi-typescript http://shipmunk-doms.shipmunk.internal.staging.sellsuki.com/doms/docs/swagger.json --output ./src/service/doms-gen.ts",
    "generate-openapi:pis": "openapi-typescript http://pis-api.sellsuki.internal.staging.sellsuki.com/swagger/doc.json --output ./src/service/pis-gen.ts",
    "generate-openapi:customer-book-v2": "openapi-typescript http://customer-book-backend-v2.patona.internal.staging.sellsuki.com/v1/swagger/swagger.json --output ./src/service/customer-book-v2-gen.ts",
    "generate-openapi:i18n": "openapi-typescript http://i18n-management-backend.sellsuki.internal.staging.sellsuki.com/v1/swagger/swagger.json --output ./src/service/i18n-gen.ts"
  },
  "devDependencies": {
    "@rollup/pluginutils": "^5.1.4",
    "@sveltejs/vite-plugin-svelte": "^3.1.1",
    "@tsconfig/svelte": "^5.0.2",
    "@types/lodash": "^4.17.9",
    "@types/node": "^20.11.5",
    "axios": "^1.9.0",
    "prettier": "^3.2.4",
    "prettier-plugin-svelte": "^3.1.2",
    "svelte": "^4.2.8",
    "svelte-check": "^3.6.2",
    "svelte-forms-lib": "^2.0.1",
    "svelte-routing": "^2.11.0",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^1.2.0",
    "yup": "^1.4.0"
  },
  "dependencies": {
    "@sellsuki-org/sellsuki-components": "0.27.0-beta.1",
    "@zxing/browser": "^0.2.1",
    "dexie": "^4.0.1-beta.7",
    "lodash": "^4.17.21",
    "openapi-typescript": "^5.4.1",
    "sellsuki-paper-template-renderer": "^1.1.7",
    "svelte-easy-crop": "^2.0.3",
    "svelte-infinite-scroll": "^2.0.1",
    "svelte-preprocess-remove-attribute": "^1.0.5"
  }
}